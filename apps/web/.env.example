# ==============================================================================
# OPTIONAL ENV OVERRIDES — every value here ALREADY has a default in
# /white-label.config.ts (the single file to edit for a new library client).
#
# Use env vars ONLY to override values at build/deploy time without touching
# the repo (e.g. Cloudflare Pages / Vercel / Render dashboard env vars).
# Local dev works with zero env files — just edit white-label.config.ts.
# ==============================================================================

# ── Supabase (optional override; default lives in white-label.config.ts) ──────
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SERVER-SIDE ONLY — never expose to the client. Set on the hosting dashboard.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Backend API & Worker secrets (set on the Cloudflare Worker, not here) ─────
NEXT_PUBLIC_API_URL="https://your-library-api.your-domain.workers.dev"
INTERNAL_API_SECRET_KEY=""
# Cloudflare Worker dashboard vars: RESEND_API_KEY, RESEND_FROM_EMAIL,
# FCM_PROJECT_ID, FCM_CLIENT_EMAIL, FCM_PRIVATE_KEY

# ── Branding overrides (optional — white-label.config.ts is the source) ───────
# NEXT_PUBLIC_LIBRARY_NAME="Apex Digital"
# NEXT_PUBLIC_LIBRARY_FULL_NAME="Apex Digital Study Library"
# NEXT_PUBLIC_LIBRARY_PHONE="+91 9876543210"
# NEXT_PUBLIC_ADMIN_EMAIL="admin@apexdigitallibrary.com"
# NEXT_PUBLIC_SITE_URL="https://apexdigitallibrary.com"
