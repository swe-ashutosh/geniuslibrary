{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "d1:create": "wrangler d1 create genius-library-d1",
    "d1:migrate": "wrangler d1 execute genius-library-d1 --remote --file=./src/db/seed.sql --yes",
    "d1:migrate:local": "wrangler d1 execute genius-library-d1 --local --file=./src/db/seed.sql --yes"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.110.0"
  }
}